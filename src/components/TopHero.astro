---
// トップページのメインビジュアル（007 の仮のデザイン）。旅館の花頭窓の形に切り抜いた写真と、縦書きの明朝のキャッチコピー。
// キャッチコピーは画像ではなく文字で出す（FR-002）。元のデザインはタグ design-original にある（docs/design-original.md）
import ClippedPhoto from './ClippedPhoto.astro';
import Fukidashi from './Fukidashi.astro';
import photo from '../assets/top/top_hero.jpg';
---

<section class="top-hero content-inner" aria-label="わくやの紹介">
  <div class="top-hero__text">
    <span class="eyebrow" aria-hidden="true">Fukushima Folk Craft — since 1975</span>
    <h1 class="top-hero__catch">
      ふくしまで、<br />長く愛されてきた民芸品、<br />めんこい和雑貨たち、<br />心の琴線にふれるお気に入りに<br />めぐり会う「わくや」です。
    </h1>
  </div>
  <figure class="top-hero__figure">
    <ClippedPhoto class="top-hero__photo" src={photo} alt="" shape="katomado" align="xMaxYMid" />
    <Fukidashi speaker="akabeko" class="top-hero__bubble">ようこそ、わくやへ。</Fukidashi>
  </figure>
</section>

<style>
  .top-hero {
    display: grid;
    gap: var(--space-lg);
    margin-block: var(--space-lg) var(--space-xl);
  }

  .top-hero__text {
    display: grid;
    gap: var(--space-sm);
  }

  .top-hero__catch {
    font-size: var(--font-size-md);
    letter-spacing: var(--letter-spacing-wide);
    line-height: var(--line-height-base);
  }

  .top-hero__figure {
    position: relative;
    width: min(100%, 420px); /* 窓の形が間延びしない大きさ */
    margin-inline: auto;
  }

  .top-hero__figure :global(.top-hero__photo) {
    width: 100%;
  }

  .top-hero__figure :global(.top-hero__bubble) {
    position: absolute;
    bottom: var(--space-sm);
    left: calc(-1 * var(--space-xs));
  }

  /* 768px 以上（tokens.css --breakpoint-md）：右に窓、左に縦書きのキャッチコピー */
  @media (min-width: 768px) {
    .top-hero {
      grid-template-columns: 1fr minmax(0, 460px);
      align-items: center;
      gap: var(--space-xl);
      margin-block: var(--space-xl) var(--space-2xl);
    }

    .top-hero__text {
      grid-template-columns: auto auto;
      justify-content: center;
      align-items: start;
      gap: var(--space-lg);
    }

    /* 英字の添え書きは縦に置き、キャッチコピーの左の細い柱にする */
    .top-hero__text .eyebrow {
      order: 2;
      writing-mode: vertical-rl;
      padding-left: var(--space-sm);
      border-left: 1px solid var(--color-line);
    }

    .top-hero__catch {
      font-size: var(--font-size-hero);
      line-height: 2.2; /* 縦書きの行の間をゆったり取る */
      writing-mode: vertical-rl;
    }

    .top-hero__figure {
      width: 100%;
    }

    .top-hero__figure :global(.top-hero__bubble) {
      left: calc(-1 * var(--space-lg));
    }
  }
</style>
