---
// お問い合わせ（FR-009・FR-010）。静的サイトのためフォームは持たず、メールと電話の案内にする（サイト側で個人情報を預からない）
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import photo from '../assets/pages/contact_hero.jpg';
import icon from '../assets/brand/icon_red.png';
import { store } from '../data/site';
import { breadcrumbJsonLd, contactPageJsonLd } from '../lib/structured-data';

const path = '/contact/';
const description = 'わくや（有限会社和久屋）へのお問い合わせは、メールまたはお電話でお願いします。民芸品のこと、マルシェやイベントへの出張のご依頼もお気軽にどうぞ。';
---

<BaseLayout
  title="お問い合わせ"
  description={description}
  path={path}
  shopBanner={false}
  jsonLd={[
    contactPageJsonLd({ name: 'お問い合わせ', path, description }),
    breadcrumbJsonLd([
      { name: 'トップ', path: '/' },
      { name: 'お問い合わせ', path },
    ]),
  ]}
>
  <PageHero title="お問い合わせ" photo={photo} photoAlt="「和久屋」の文字を染め抜いた紺色の半纏" icon={icon} />
  <section class="contact" aria-label="連絡先">
    <dl class="contact__list content-inner">
      <div class="contact__item">
        <dt>メール</dt>
        <dd><a href={`mailto:${store.email}`}>{store.email}</a></dd>
      </div>
      <div class="contact__item">
        <dt>お電話</dt>
        <dd>
          <a href={`tel:${store.telephone}`}>{store.telephone}</a>
          <p class="contact__note">{store.telephoneNote}</p>
        </dd>
      </div>
    </dl>
  </section>
</BaseLayout>

<style>
  .contact {
    margin-bottom: var(--space-xl);
    padding-block: var(--space-lg);
    background: var(--color-bg-subtle);
  }

  .contact__list {
    display: grid;
    gap: var(--space-sm);
    max-width: 600px; /* 現行 .contact_tb の幅（本文幅の 55%）に近い読みやすい幅 */
  }

  .contact__item {
    padding: var(--space-sm);
    background: var(--color-bg);
  }

  .contact__item dt {
    margin-bottom: var(--space-2xs);
    font-size: var(--font-size-xs);
  }

  .contact__item a {
    display: inline-flex;
    align-items: center;
    min-height: var(--size-tap-min);
    font-size: var(--font-size-lg);
  }

  .contact__note {
    font-size: var(--font-size-xs);
  }
</style>
