---
// トップページの「わくやの想い」の紹介（FR-006）。縦書きの文章と、民芸の形（丸・起き上がり小法師・こけし）に切り抜いた写真3枚。
// 007 の仮のデザイン。元のデザイン（画像の見出しと曲線の写真）はタグ design-original にある
import ClippedPhoto from './ClippedPhoto.astro';
import photo1 from '../assets/top/thought01.png';
import photo2 from '../assets/top/thought02.png';
import photo3 from '../assets/top/thought03.png';
import MoreLink from './MoreLink.astro';
---

<section class="thought content-inner" aria-labelledby="thought-title">
  <div class="thought__body">
    <h2 id="thought-title" class="thought__title">わくやの想い</h2>
    <div class="thought__text">
      <p>はじまりは「来て。」から、</p>
      <p>こんどは「かなえる。」ために。</p>
    </div>
    <div class="thought__text">
      <p>つながった交流をより豊かに持続可能に、</p>
      <p>深く確かなものとするために、</p>
      <p>はじめます。</p>
    </div>
  </div>
  <MoreLink href="/thought/" what="わくやの想いを" align="start" />
  <div class="thought__photos" aria-hidden="true">
    <ClippedPhoto class="thought__photo thought__photo--1" src={photo1} alt="" shape="circle" zoom={1.7} />
    <ClippedPhoto class="thought__photo thought__photo--2" src={photo2} alt="" shape="koboshi" zoom={1.8} />
    <ClippedPhoto class="thought__photo thought__photo--3" src={photo3} alt="" shape="kokeshi" zoom={1.3} />
  </div>
</section>

<style>
  .thought {
    position: relative;
    margin-block: var(--space-xl);
  }

  /* 縦書きを右から読む順に並べる（見出し → 1つ目 → 2つ目） */
  .thought__body {
    display: flex;
    flex-direction: row-reverse;
    justify-content: center;
    gap: var(--space-md);
    font-family: var(--font-family-mincho);
    line-height: 2; /* 縦書きの行の間 */
  }

  .thought__title {
    padding-left: var(--space-sm);
    border-left: 1px solid var(--color-accent);
    font-size: var(--font-size-xl);
    writing-mode: vertical-rl;
  }

  .thought__text {
    writing-mode: vertical-rl;
    white-space: nowrap;
  }

  .thought > :global(.more-link) {
    margin-top: var(--space-md);
    text-align: center;
  }

  .thought__photos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-sm);
    align-items: center;
    margin-top: var(--space-md);
  }

  .thought__photos :global(.thought__photo--3) {
    grid-row: span 2;
  }

  /* 768px 以上（tokens.css --breakpoint-md）：写真3枚を文章の周りに置く */
  @media (min-width: 768px) {
    .thought {
      min-height: 560px; /* 写真3枚を周りに置く高さ */
      margin-block: var(--space-2xl);
      padding-block: var(--space-lg);
    }

    .thought__body {
      gap: var(--space-lg);
    }

    .thought__title {
      font-size: var(--font-size-2xl);
    }

    .thought__photos {
      display: contents;
    }

    .thought__photos :global(.thought__photo) {
      position: absolute;
    }

    .thought__photos :global(.thought__photo--1) {
      top: 0;
      left: 0;
      width: 140px; /* 文章に重ならない大きさ */
    }

    .thought__photos :global(.thought__photo--2) {
      bottom: 0;
      left: 6%;
      width: 150px;
    }

    .thought__photos :global(.thought__photo--3) {
      top: 10%;
      right: 0;
      width: 150px;
    }
  }

  /* 写真が文章に重ならない広さでは、写真を大きく見せる（tokens.css --breakpoint-lg） */
  @media (min-width: 1025px) {
    .thought__photos :global(.thought__photo--1) {
      width: 220px; /* 1025px 以上で写真を大きく見せる幅 */
    }

    .thought__photos :global(.thought__photo--2) {
      width: 230px;
    }

    .thought__photos :global(.thought__photo--3) {
      width: 240px;
    }
  }
</style>
