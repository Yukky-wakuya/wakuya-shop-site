---
// 存在しない URL の案内（specs/004-not-found）。dist/404.html があると、Cloudflare Pages は存在しない URL にステータス 404 でこのページを返す
import BaseLayout from '../layouts/BaseLayout.astro';
import Fukidashi from '../components/Fukidashi.astro';
---

<BaseLayout
  title="ページが見つかりません"
  description="お探しのページは見つかりませんでした。わくやのトップページまたはブログ一覧からお探しください。"
  path="/404.html"
  noindex
>
  <div class="content-inner not-found">
    <span class="eyebrow" aria-hidden="true">404 — Not Found</span>
    <h1 class="not-found__title">ページが見つかりません</h1>
    <Fukidashi speaker="kokeshi" class="not-found__bubble">道に迷ってしまったようです。</Fukidashi>
    <p>お探しのページは、移動または削除されたか、URL が間違っている可能性があります。</p>
    <ul class="not-found__links">
      <li><a href="/">トップページへ</a></li>
      <li><a href="/blogs/">ブログ一覧へ</a></li>
    </ul>
  </div>
</BaseLayout>

<style>
  .not-found {
    display: grid;
    justify-items: start;
    gap: var(--space-sm);
    padding-block: var(--space-xl);
  }

  .not-found__title {
    font-size: var(--font-size-xl);
  }

  .not-found__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin-top: var(--space-md);
  }

  .not-found__links a {
    display: inline-flex;
    align-items: center;
    min-height: var(--size-tap-min);
    font-family: var(--font-family-mincho);
  }
</style>
