---
// ヘッダーナビ（007 の仮のデザイン）。PC幅は明朝の横並び、それより狭い幅は <details> の開閉メニュー。
// どちらも JavaScript を使わない（FR-012、research.md §5）。項目は site.ts の nav の1か所で管理する。
import { nav } from '../data/site';
import Mingei from './Mingei.astro';

const current = Astro.url.pathname;
const isCurrent = (href: string) => href === current;
---

<nav class="nav-pc" aria-label="メインメニュー">
  <ul>
    {
      nav.map((item) => (
        <li>
          <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined} {...(item.external ? { target: '_blank', rel: 'noopener' } : {})}>
            {item.label}
            {item.external && <span class="visually-hidden">（外部サイト・新しいタブで開きます）</span>}
          </a>
        </li>
      ))
    }
  </ul>
</nav>

<details class="nav-sp">
  <summary>
    <span class="nav-sp__bars" aria-hidden="true"><span></span><span></span></span>
    <span class="nav-sp__label">メニュー</span>
  </summary>
  <nav aria-label="メインメニュー（スマートフォン）">
    <ul>
      {
        nav.map((item) => (
          <li>
            <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined} {...(item.external ? { target: '_blank', rel: 'noopener' } : {})}>
              {item.label}
              {item.external && <span class="visually-hidden">（外部サイト・新しいタブで開きます）</span>}
            </a>
          </li>
        ))
      }
    </ul>
    <Mingei kind="akabeko" class="nav-sp__motif" />
  </nav>
</details>

<style>
  /* ---- PC：明朝の横並び ---- */
  .nav-pc {
    display: none;
  }

  .nav-pc ul {
    display: flex;
    gap: var(--space-sm);
  }

  .nav-pc a {
    position: relative;
    display: flex;
    align-items: center;
    min-height: var(--size-tap-min);
    font-family: var(--font-family-mincho);
    font-size: var(--font-size-xs);
    letter-spacing: var(--letter-spacing-wide);
    text-decoration: none;
  }

  /* 今のページは、文字の下に朱の小さな点（あかべこの斑点のような印） */
  .nav-pc a[aria-current='page']::after {
    content: '';
    position: absolute;
    bottom: 4px; /* 文字のすぐ下 */
    left: 50%;
    width: 6px; /* 小さな点 */
    height: 6px;
    border-radius: 50%;
    background: var(--color-accent);
    transform: translateX(-50%);
  }

  .nav-pc a[aria-current='page'] {
    color: var(--color-accent);
  }

  /* ---- スマートフォン・タブレット：<details> の開閉メニュー ---- */
  .nav-sp summary {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: var(--space-2xs);
    min-width: var(--size-tap-min);
    min-height: var(--size-tap-min);
    cursor: pointer;
    list-style: none;
  }

  .nav-sp summary::-webkit-details-marker {
    display: none;
  }

  .nav-sp__bars {
    display: grid;
    gap: 7px; /* 2本線の間隔 */
    width: 28px; /* 2本線の幅 */
  }

  .nav-sp__bars span {
    display: block;
    height: 1px; /* 細い線で静かに見せる */
    background: var(--color-text);
  }

  .nav-sp__label {
    font-size: var(--font-size-2xs);
    line-height: 1;
  }

  .nav-sp > nav {
    position: absolute;
    inset-inline: 0;
    top: 100%;
    z-index: 100;
    padding-block: var(--space-md) var(--space-lg);
    border-block: 1px solid var(--color-line);
    background: var(--color-bg);
  }

  .nav-sp li {
    width: 80%; /* 左右に余白を残した細い列 */
    margin-inline: auto;
    border-bottom: 1px solid var(--color-line);
  }

  .nav-sp a {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: var(--size-tap-min);
    padding: var(--space-xs) var(--space-sm);
    font-family: var(--font-family-mincho);
    letter-spacing: var(--letter-spacing-wide);
    text-decoration: none;
    text-align: center;
  }

  .nav-sp a[aria-current='page'] {
    color: var(--color-accent);
  }

  .nav-sp :global(.nav-sp__motif) {
    width: 56px; /* メニューの下に添える小さなあかべこ */
    margin: var(--space-md) auto 0;
  }

  /* ナビを1行に並べられる広さ（tokens.css --breakpoint-lg） */
  @media (min-width: 1025px) {
    .nav-pc {
      display: block;
    }

    .nav-sp {
      display: none;
    }
  }
</style>
