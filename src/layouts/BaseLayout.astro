---
// 全ページ共通のレイアウト（contracts/layout-props.md、開発原則VI）
import '../styles/tokens.css';
import '../styles/global.css';
import Seo from '../components/Seo.astro';
import JsonLd from '../components/JsonLd.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ShopBanner from '../components/ShopBanner.astro';
import { storeJsonLd, type JsonLdObject } from '../lib/structured-data';

interface Props {
  title: string;
  description: string;
  path: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  jsonLd?: JsonLdObject[];
  noindex?: boolean;
}

const { jsonLd = [], ...seo } = Astro.props;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <Seo {...seo} />
    <JsonLd items={[storeJsonLd(), ...jsonLd]} />
  </head>
  <body>
    <a class="skip-link" href="#main">本文へスキップ</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <ShopBanner />
    <Footer />
  </body>
</html>
