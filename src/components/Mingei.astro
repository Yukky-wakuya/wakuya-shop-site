---
// 福島の民芸のモチーフ（007 の仮のデザイン）。あかべこ・こけし・三春駒・起き上がり小法師を、
// 線と面だけの小さな図にしたもの。飾りなので読み上げない（aria-hidden）。色は tokens.css を参照する
export type MingeiKind = 'akabeko' | 'kokeshi' | 'koma' | 'koboshi';

interface Props {
  kind: MingeiKind;
  class?: string;
}

const { kind, class: className } = Astro.props;
const VIEWBOX: Record<MingeiKind, string> = {
  akabeko: '0 0 80 60',
  kokeshi: '0 0 40 80',
  koma: '0 0 72 60',
  koboshi: '0 0 40 46',
};
---

<svg class:list={['mingei', `mingei--${kind}`, className]} viewBox={VIEWBOX[kind]} aria-hidden="true" focusable="false">
  {
    kind === 'akabeko' && (
      <g>
        {/* 脚 */}
        <rect class="ink" x="29" y="40" width="6" height="14" rx="1" />
        <rect class="ink" x="39" y="42" width="5" height="12" rx="1" />
        <rect class="ink" x="57" y="42" width="5" height="12" rx="1" />
        <rect class="ink" x="66" y="40" width="6" height="14" rx="1" />
        {/* しっぽ */}
        <path class="ink-line" d="M74 27 q6 3 4 11" />
        {/* 胴と首（首を少し下げて、うなずく形） */}
        <rect class="red" x="26" y="19" width="50" height="27" rx="13" />
        <path class="red" d="M31 21 L19 26 L18 42 L33 44 Z" />
        {/* 頭 */}
        <ellipse class="red" cx="13" cy="37" rx="11.5" ry="8.5" transform="rotate(28 13 37)" />
        <ellipse class="ink" cx="6.5" cy="43.5" rx="4.2" ry="3.4" transform="rotate(28 6.5 43.5)" />
        <path class="ink" d="M15 28 Q13 22 17 19 Q16 24 19 28 Z M20 29 Q20 23 24 21 Q22 25 23 30 Z" />
        <circle class="paper" cx="12" cy="34" r="2.6" />
        <circle class="ink" cx="11.6" cy="34.3" r="1.3" />
        {/* 首の飾りと、胴の斑点 */}
        <path class="ochre-line" d="M29 22 L31 43" />
        <circle class="spot" cx="44" cy="30" r="3.6" />
        <circle class="spot" cx="56" cy="27" r="3.4" />
        <circle class="spot" cx="64" cy="36" r="3" />
      </g>
    )
  }
  {
    kind === 'kokeshi' && (
      <g>
        {/* 胴 */}
        <rect class="red" x="11" y="33" width="18" height="45" rx="4" />
        <path class="ochre-line" d="M11 40 H29 M11 71 H29" />
        <circle class="paper" cx="20" cy="55" r="4.5" />
        <circle class="ochre" cx="20" cy="55" r="1.8" />
        <path class="green-line" d="M15 62 q2 -3 5 -2 M25 62 q-2 -3 -5 -2" />
        {/* 頭 */}
        <circle class="paper" cx="20" cy="19" r="16" />
        <path class="ink" d="M4.2 18 A15.8 15.8 0 0 1 35.8 18 C31 13.5 26 12.5 20 14.5 C14 12.5 9 13.5 4.2 18 Z" />
        <circle class="red" cx="6" cy="22" r="2.4" />
        <circle class="red" cx="34" cy="22" r="2.4" />
        <path class="ink-line thin" d="M12.5 22.5 q2.5 -2 5 0 M22.5 22.5 q2.5 -2 5 0" />
        <circle class="red" cx="20" cy="28.5" r="1.3" />
      </g>
    )
  }
  {
    kind === 'koma' && (
      <g>
        {/* 三春駒：木を削った角ばった黒い馬に、色の飾り */}
        <path class="ink" d="M10 8 L16 2 L19 9 L24 16 L32 24 L58 24 L64 21 L69 27 L67 40 L62 33 L60 37 L60 56 L51 56 L49 42 L30 42 L28 56 L19 56 L20 36 L16 26 L8 28 L4 24 L6 16 Z" />
        <rect class="red" x="34" y="24" width="15" height="7" />
        <path class="ochre-line" d="M34 31 H49 M23 28 L31 26" />
        <path class="ochre-line thin" d="M8 18 L14 15 L18 22" />
        <circle class="paper" cx="10.5" cy="14" r="1.4" />
        <circle class="green" cx="55" cy="33" r="2.6" />
        <circle class="ochre" cx="25" cy="20" r="1.3" />
        <circle class="ochre" cx="22" cy="16" r="1.1" />
      </g>
    )
  }
  {
    kind === 'koboshi' && (
      <g>
        {/* 会津の起き上がり小法師 */}
        <path class="red" d="M20 2 C31 2 37 16 37 28 C37 38 29 44 20 44 C11 44 3 38 3 28 C3 16 9 2 20 2 Z" />
        <ellipse class="paper" cx="20" cy="19" rx="9.5" ry="8.5" />
        <path class="ink" d="M10.6 17 C11 11 15 9.5 20 9.5 C25 9.5 29 11 29.4 17 C26 13.5 23 13 20 14 C17 13 14 13.5 10.6 17 Z" />
        <circle class="ink" cx="16.5" cy="20" r="1.1" />
        <circle class="ink" cx="23.5" cy="20" r="1.1" />
        <circle class="red" cx="20" cy="24" r="1" />
        <path class="ochre-line" d="M8 34 Q20 39 32 34" />
      </g>
    )
  }
</svg>

<style>
  .mingei {
    display: block;
    overflow: visible;
  }

  .red {
    fill: var(--color-accent);
  }

  .ink {
    fill: var(--color-text);
  }

  .paper {
    fill: var(--color-bg-raised);
  }

  .ochre {
    fill: var(--color-ochre);
  }

  .green {
    fill: var(--color-green);
  }

  .spot {
    fill: var(--color-text);
    stroke: var(--color-bg-raised);
    stroke-width: 1.2; /* 斑点の白い縁（図の中の線の太さ。viewBox の単位） */
  }

  .ink-line,
  .ochre-line,
  .green-line {
    fill: none;
    stroke-linecap: round;
    stroke-width: 2; /* 図の中の線の太さ（viewBox の単位） */
  }

  .thin {
    stroke-width: 1.2; /* 顔の細い線（viewBox の単位） */
  }

  .ink-line {
    stroke: var(--color-text);
  }

  .ochre-line {
    stroke: var(--color-ochre);
  }

  .green-line {
    stroke: var(--color-green);
  }
</style>
