---
// 写真を形に切り抜いて表示する（SVG の clipPath）。007 の仮のデザインの形：
//   katomado … 旅館や寺の花頭窓（かとうまど）   arch … 上の丸いアーチ窓   wide-arch … 横長のアーチ窓
//   kokeshi … こけしの形
//   koboshi … 起き上がり小法師の卵形          circle … 丸
// 元のデザインの曲線の形（top・sub）は、タグ design-original の同じファイルにある（docs/design-original.md）
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { uid } from '../lib/uid';

const SHAPES = {
  katomado: {
    viewBox: '0 0 100 125',
    d: 'M0 125 L0 52 C0 41 5 36 10 33 C16 29 19 20 27 14 C35 8 44 6 50 0 C56 6 65 8 73 14 C81 20 84 29 90 33 C95 36 100 41 100 52 L100 125 Z',
  },
  arch: {
    viewBox: '0 0 100 120',
    d: 'M0 120 L0 50 A50 50 0 0 1 100 50 L100 120 Z',
  },
  'wide-arch': {
    viewBox: '0 0 160 110',
    d: 'M0 110 L0 60 A80 60 0 0 1 160 60 L160 110 Z',
  },
  kokeshi: {
    viewBox: '0 0 100 150',
    d: 'M12 40 A38 38 0 1 1 88 40 A38 38 0 1 1 12 40 Z M30 70 H70 A10 10 0 0 1 80 80 V140 A10 10 0 0 1 70 150 H30 A10 10 0 0 1 20 140 V80 A10 10 0 0 1 30 70 Z',
  },
  koboshi: {
    viewBox: '0 0 100 115',
    d: 'M50 0 C80 0 98 38 98 68 C98 96 76 115 50 115 C24 115 2 96 2 68 C2 38 20 0 50 0 Z',
  },
  circle: {
    viewBox: '0 0 100 100',
    d: 'M0 50 A50 50 0 1 1 100 50 A50 50 0 1 1 0 50 Z',
  },
} as const;

export type PhotoShape = keyof typeof SHAPES;

interface Props {
  src: ImageMetadata;
  /** 空文字なら装飾として読み上げない */
  alt: string;
  shape: PhotoShape;
  class?: string;
  /** 写真を拡大して中央を使う倍率（元の写真の縁が透明なときに、透明な部分を形の外に出す） */
  zoom?: number;
  /** 写真のどこを見せるか（preserveAspectRatio の値） */
  align?: 'xMidYMid' | 'xMidYMin' | 'xMidYMax' | 'xMinYMid' | 'xMaxYMid';
}

const { src, alt, shape, class: className, zoom = 1, align = 'xMidYMid' } = Astro.props;
const { viewBox, d } = SHAPES[shape];
// SVG の <image> は srcset を持てないため、高精細の画面でも足りる幅で1枚に最適化する
const image = await getImage({ src, width: Math.min(src.width, 1600), format: 'webp', quality: 80 });
// 同じ形を1ページで何度使っても id が重ならないようにする
const clipId = uid(`clip-${shape}`);
const offset = `${(-(zoom - 1) / 2) * 100}%`;
const size = `${zoom * 100}%`;
---

<svg class:list={['clipped-photo', className]} viewBox={viewBox} role={alt ? 'img' : undefined} aria-label={alt || undefined} aria-hidden={alt ? undefined : 'true'} focusable="false">
  <defs>
    <clipPath id={clipId}>
      <path d={d}></path>
    </clipPath>
  </defs>
  <g clip-path={`url(#${clipId})`}>
    <rect width="100%" height="100%" class="clipped-photo__mat"></rect>
    <image href={image.src} x={offset} y={offset} width={size} height={size} preserveAspectRatio={`${align} slice`}></image>
  </g>
</svg>

<style>
  /* 写真が透明な部分は、生成りの台紙の色にする */
  .clipped-photo__mat {
    fill: var(--color-bg-subtle);
  }
</style>
