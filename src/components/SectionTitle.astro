---
// セクション見出し。現行 .h2_title と同じく、アイコン＋明朝の見出し
import { Image } from 'astro:assets';
import icon from '../assets/brand/h_icon.svg';

interface Props {
  level?: 'h1' | 'h2';
  /** 見出しの id（セクションの aria-labelledby から参照する） */
  id?: string;
}

const { level: Tag = 'h2', id } = Astro.props;
---

<div class="section-title">
  <Image class="section-title__icon" src={icon} alt="" />
  <Tag class="section-title__text" id={id}><slot /></Tag>
</div>

<style>
  .section-title {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    margin-bottom: var(--space-md);
  }

  .section-title :global(.section-title__icon) {
    width: 30px; /* 現行 .title_icon（SP）の幅 */
  }

  .section-title__text {
    font-size: var(--font-size-lg);
  }

  /* 現行の切り替え幅 768px（tokens.css --breakpoint-md）。@media では var() が使えないため直接書く */
  @media (min-width: 768px) {
    .section-title :global(.section-title__icon) {
      width: 46px; /* 現行 .title_icon の幅 */
    }

    .section-title__text {
      font-size: var(--font-size-2xl);
    }
  }
</style>
