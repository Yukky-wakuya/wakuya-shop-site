---
// 公式SNSへのリンク。ヘッダー（濃い色のアイコン）とフッター（白いアイコン）で使う
import { Image } from 'astro:assets';
import { social } from '../data/site';
import xDark from '../assets/brand/xicon.png';
import facebookDark from '../assets/brand/facebook.png';
import instagramDark from '../assets/brand/insta.png';
import xLight from '../assets/brand/x-white.png';
import facebookLight from '../assets/brand/facebook_w.svg';
import instagramLight from '../assets/brand/insta_w.svg';

interface Props {
  variant: 'dark' | 'light';
  size: number;
}

const { variant, size } = Astro.props;
const icons = {
  dark: { x: xDark, facebook: facebookDark, instagram: instagramDark },
  light: { x: xLight, facebook: facebookLight, instagram: instagramLight },
}[variant];
---

<ul class="social">
  {
    social.map((s) => (
      <li>
        <a href={s.href} target="_blank" rel="noopener">
          <Image src={icons[s.icon]} alt={`${s.label}（外部サイト・新しいタブで開きます）`} width={size} height={size} />
        </a>
      </li>
    ))
  }
</ul>

<style>
  .social {
    display: flex;
    gap: var(--space-xs);
  }

  .social a {
    display: grid;
    place-items: center;
    min-width: var(--size-tap-min);
    min-height: var(--size-tap-min);
  }

  .social img {
    object-fit: contain;
  }
</style>
