---
// ブログの記事ページ。現行と同じ URL（/<番号>/）で公開する（FR-009〜FR-012）
import { getImage } from 'astro:assets';
import { render } from 'astro:content';
import BlogLayout from '../layouts/BlogLayout.astro';
import SectionTitle from '../components/SectionTitle.astro';
import PostNav from '../components/PostNav.astro';
import RecommendedProducts from '../components/RecommendedProducts.astro';
import noImage from '../assets/brand/no-image.png';
import { categoryLabel, categoryPath } from '../data/categories';
import { formatDate, getPublishedPosts, postPath, type Post } from '../lib/blog';
import { adjacent, makeDescription } from '../lib/blog-core';
import { blogPostingJsonLd, breadcrumbJsonLd } from '../lib/structured-data';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { post: post.id }, props: { post, ...adjacent(posts, post.id) } }));
}

interface Props {
  post: Post;
  older?: Post;
  newer?: Post;
}

const { post, older, newer } = Astro.props;
const { Content } = await render(post);
const path = postPath(post);
const description = makeDescription(post.data.description, post.body ?? '');
const og = post.data.hero ? (await getImage({ src: post.data.hero, width: 1200, format: 'jpg' })).src : undefined;
---

<BlogLayout
  title={post.data.title}
  description={description}
  path={path}
  heroTitle="ブログ"
  heroPhoto={post.data.hero ?? noImage}
  heroPhotoAlt={post.data.hero ? (post.data.heroAlt ?? '') : 'わくやのロゴ'}
  heroHeading={false}
  ogType="article"
  ogImage={og}
  jsonLd={[
    blogPostingJsonLd({ title: post.data.title, date: post.data.date, path, description, image: og }),
    breadcrumbJsonLd([
      { name: 'トップ', path: '/' },
      { name: 'ブログ一覧', path: '/blogs/' },
      { name: post.data.title, path },
    ]),
  ]}
>
  <article class="post">
    <header class="post__header">
      <SectionTitle level="h1">{post.data.title}</SectionTitle>
      <p class="post__meta">
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        <span class="visually-hidden">カテゴリー：</span>
        {
          post.data.categories.map((c) => (
            <a class="post__category" href={categoryPath(c)}>
              {categoryLabel(c)}
            </a>
          ))
        }
      </p>
    </header>
    <div class="post__body">
      <Content />
    </div>
  </article>
  <PostNav older={older} newer={newer} />
  <RecommendedProducts slot="after" />
</BlogLayout>

<style>
  .post__header {
    margin-bottom: var(--space-md);
  }

  .post__header :global(.section-title) {
    margin-bottom: var(--space-xs);
  }

  .post__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-xs) var(--space-sm);
    font-size: var(--font-size-xs);
  }

  .post__category {
    display: inline-flex;
    align-items: center;
    min-height: var(--size-tap-min);
  }

  /* 本文（Markdown から作った HTML） */
  .post__body :global(p),
  .post__body :global(ul) {
    margin-bottom: 1em; /* 現行 .single_content p の margin-bottom 1em。文字の大きさに合わせるため em */
  }

  .post__body :global(ul) {
    padding-left: 1.5em; /* 黒丸の分の字下げ。文字の大きさに合わせるため em で書く */
    list-style: disc;
  }

  .post__body :global(img) {
    max-width: min(100%, 400px); /* 現行の本文の写真は幅 369px 前後で表示されていた */
    margin: var(--space-sm) auto;
  }

  .post__body :global(.embed) {
    aspect-ratio: 16 / 9;
    margin-block: var(--space-sm);
  }

  .post__body :global(.embed iframe) {
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
