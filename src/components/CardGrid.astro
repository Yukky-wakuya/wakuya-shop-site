---
// 商品・記事のカードを並べる格子（現行 .recommend_list・.news_list・.blog_archive_list）
// スマートフォンは2列、PC は columns 列
interface Props {
  columns?: 3 | 4;
  label?: string;
}

const { columns = 4, label } = Astro.props;
---

<ul class:list={['card-grid', `card-grid--${columns}`]} aria-label={label}>
  <slot />
</ul>

<style>
  .card-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-md) var(--space-sm);
    margin-bottom: var(--space-md);
  }

  /* 現行の切り替え幅 768px（tokens.css --breakpoint-md）。@media では var() が使えないため直接書く */
  @media (min-width: 768px) {
    .card-grid {
      gap: var(--space-grid);
    }

    .card-grid--3 {
      grid-template-columns: repeat(3, 1fr);
    }

    .card-grid--4 {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
