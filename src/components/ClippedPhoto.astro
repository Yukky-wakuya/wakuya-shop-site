---
// 写真を曲線の形に切り抜いて表示する（現行 .tophero_svg・.subhero_svg と同じ SVG の clipPath）
// 形は現行サイトの path をそのまま使う（docs/current-site/design.md）
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

const SHAPES = {
  top: {
    viewBox: '0 0 1006.6 660.36',
    d: 'm928.45,78.79c-76.47,1.41-163.14,3.01-256.55-8.29-85.51-10.35-161.29-26.16-228.15-40.12C370.59,15.11,303.83,1.17,244.72,0h-15.8c-22.68.48-44.16,3.09-64.37,8.51-47.2,12.68-87.46,40.77-119.8,93.1-58.49,94.65-59.69,202.84-3.37,304.65,73.01,131.94,229.83,227.39,409.27,249.11,24.79,3,50.4,4.64,76.55,4.99h22.33c153.94-2.13,323.95-47.18,457.05-121.59V78.03c-25.13-.22-51.35.26-78.14.76Z',
  },
  sub: {
    viewBox: '0 0 755.93 468.47',
    d: 'm656.03,56.36c-54.04.95-115.29,2.03-181.31-6.04-60.44-7.39-114-18.65-161.26-28.59C236.76,5.6,170.03-8.43,116.13,6.05c-33.35,8.96-61.78,28.85-84.6,65.92-41.28,67.06-42.05,143.76-2.18,215.97,51.68,93.58,162.57,161.36,289.4,176.87,141.33,17.28,320.29-27.94,437.19-110.13V57.81c-30.28-2.67-64.38-2.07-99.9-1.44Z',
  },
} as const;

interface Props {
  src: ImageMetadata;
  /** 空文字なら装飾として読み上げない */
  alt: string;
  shape: keyof typeof SHAPES;
  class?: string;
}

const { src, alt, shape, class: className } = Astro.props;
const { viewBox, d } = SHAPES[shape];
// SVG の <image> は srcset を持てないため、高精細の画面でも足りる幅で1枚に最適化する
const image = await getImage({ src, width: Math.min(src.width, 1600), format: 'webp', quality: 80 });
const clipId = `clip-${shape}`;
---

<svg class={className} viewBox={viewBox} role={alt ? 'img' : undefined} aria-label={alt || undefined} aria-hidden={alt ? undefined : 'true'} focusable="false">
  <defs>
    <clipPath id={clipId}>
      <path d={d}></path>
    </clipPath>
  </defs>
  <image href={image.src} width="100%" height="100%" preserveAspectRatio="xMidYMid slice" clip-path={`url(#${clipId})`}></image>
</svg>
