---
// ブログのサイドバー：カテゴリーの一覧とオンラインショップへの小さなのれん（FR-019a）。
// 007 の仮のデザイン。元のデザイン（模様のアイコンと朱の帯）はタグ design-original にある
import Mingei from './Mingei.astro';
import { categoryPath } from '../data/categories';
import { shopUrl } from '../data/site';
import { getPublishedPosts, usedCategories } from '../lib/blog';

interface Props {
  /** 今見ているカテゴリ（aria-current を付ける） */
  current?: string;
}

const { current } = Astro.props;
const list = usedCategories(await getPublishedPosts());
---

<aside class="blog-sidebar" aria-labelledby="blog-sidebar-title">
  <div class="blog-sidebar__title">
    <span class="eyebrow" aria-hidden="true">Category</span>
    <h2 id="blog-sidebar-title">カテゴリー</h2>
  </div>
  <ul class="blog-sidebar__list">
    {
      list.map((c) => (
        <li>
          <a href={categoryPath(c.slug)} aria-current={c.slug === current ? 'page' : undefined}>
            {c.label}
          </a>
        </li>
      ))
    }
  </ul>
  <a class="blog-sidebar__shop" href={shopUrl} target="_blank" rel="noopener">
    <span class="blog-sidebar__crest" aria-hidden="true"><Mingei kind="akabeko" class="blog-sidebar__motif" /></span>
    <span class="blog-sidebar__shop-label">オンライン<wbr />ショップ<span class="visually-hidden">（外部サイト・新しいタブで開きます）</span></span>
  </a>
</aside>

<style>
  .blog-sidebar__title {
    display: grid;
    gap: var(--space-2xs);
    margin-bottom: var(--space-sm);
  }

  .blog-sidebar__title h2 {
    font-size: var(--font-size-lg);
  }

  .blog-sidebar__list {
    margin-bottom: var(--space-md);
    border-top: 1px solid var(--color-line);
  }

  .blog-sidebar__list li {
    border-bottom: 1px solid var(--color-line);
  }

  .blog-sidebar__list a {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    min-height: var(--size-tap-min);
    font-family: var(--font-family-mincho);
    text-decoration: none;
  }

  /* 今のカテゴリは朱の小さな点で示す */
  .blog-sidebar__list a[aria-current='page'] {
    color: var(--color-accent);
  }

  .blog-sidebar__list a[aria-current='page']::before {
    content: '';
    width: 6px; /* 小さな点 */
    height: 6px;
    border-radius: 50%;
    background: var(--color-accent);
  }

  .blog-sidebar__list a:hover {
    text-decoration: underline;
  }

  /* 小さなのれん */
  .blog-sidebar__shop {
    display: flex;
    align-items: center;
    gap: var(--space-sm);
    padding: var(--space-md) var(--space-sm);
    border-top: 4px solid var(--color-text); /* のれんを掛ける竿 */
    background: var(--color-footer-bg);
    color: var(--color-on-accent);
    font-family: var(--font-family-mincho);
    font-size: var(--font-size-md);
    letter-spacing: var(--letter-spacing-wide);
    line-height: var(--line-height-tight);
    text-decoration: none;
  }

  .blog-sidebar__shop:hover {
    color: var(--color-on-accent);
    text-decoration: underline;
  }

  .blog-sidebar__crest {
    display: grid;
    flex: none;
    place-items: center;
    width: 52px; /* 染め抜きの丸の紋 */
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--color-bg-raised);
  }

  .blog-sidebar__crest :global(.blog-sidebar__motif) {
    width: 72%;
  }

  /* 「オンライン／ショップ」の位置でだけ折り返す */
  .blog-sidebar__shop-label {
    word-break: keep-all;
  }
</style>
