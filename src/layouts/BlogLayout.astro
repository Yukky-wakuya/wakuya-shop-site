---
// ブログの一覧・カテゴリ・記事の共通レイアウト：見出し部分、本文、サイドバー（FR-019a）
import type { ImageMetadata } from 'astro';
import BaseLayout from './BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import BlogSidebar from '../components/BlogSidebar.astro';
import type { JsonLdObject } from '../lib/structured-data';

interface Props {
  title: string;
  description: string;
  path: string;
  heroTitle: string;
  heroPhoto: ImageMetadata;
  heroPhotoAlt: string;
  /** false なら見出し部分のページ名を h1 にしない（記事ページ） */
  heroHeading?: boolean;
  currentCategory?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  jsonLd?: JsonLdObject[];
}

const { heroTitle, heroPhoto, heroPhotoAlt, heroHeading = true, currentCategory, ...base } = Astro.props;
---

<BaseLayout {...base} shopBanner={false}>
  <PageHero title={heroTitle} photo={heroPhoto} photoAlt={heroPhotoAlt} heading={heroHeading} en="Journal" motif="koboshi" />
  <div class="blog-layout content-inner">
    <div class="blog-layout__main">
      <slot />
    </div>
    <BlogSidebar current={currentCategory} />
  </div>
  <slot name="after" />
</BaseLayout>

<style>
  .blog-layout {
    display: grid;
    gap: var(--space-xl);
    margin-bottom: var(--space-xl);
  }

  /* 768px 以上（tokens.css --breakpoint-md）。@media では var() が使えないため直接書く */
  @media (min-width: 768px) {
    .blog-layout {
      margin-bottom: var(--space-2xl);
    }
  }

  /* サイドバーを横に置いても本文のカードが小さくなりすぎない広さ（tokens.css --breakpoint-lg） */
  @media (min-width: 1025px) {
    .blog-layout {
      grid-template-columns: minmax(0, 1fr) 240px; /* サイドバーは細い列 */
      gap: var(--space-xl);
      margin-bottom: var(--space-2xl);
    }
  }
</style>
