---
// 下層ページの見出し部分（007 の仮のデザイン）：左にページ名と英字の添え書き・民芸のモチーフ、右にアーチ窓の形に切り抜いた写真。
// 記事ページではページ名を見出しにしない（h1 は記事のタイトル）。元のデザイン（曲線の写真と模様）はタグ design-original にある
import type { ImageMetadata } from 'astro';
import ClippedPhoto, { type PhotoShape } from './ClippedPhoto.astro';
import Mingei, { type MingeiKind } from './Mingei.astro';

interface Props {
  title: string;
  photo: ImageMetadata;
  photoAlt: string;
  /** true ならページ名を h1 にする */
  heading?: boolean;
  /** 英字の添え書き（飾り。読み上げない） */
  en?: string;
  /** ページ名の下に添える民芸のモチーフ（ページごとに変える） */
  motif?: MingeiKind;
  /** 写真の切り抜きの形 */
  shape?: PhotoShape;
}

const { title, photo, photoAlt, heading = true, en, motif = 'kokeshi', shape = 'arch' } = Astro.props;
const Tag = heading ? 'h1' : 'p';
---

<div class="page-hero content-inner">
  <div class="page-hero__text">
    {en && <span class="eyebrow" aria-hidden="true">{en}</span>}
    <Tag class="page-hero__title">{title}</Tag>
    <Mingei kind={motif} class:list={['page-hero__motif', `page-hero__motif--${motif}`]} />
  </div>
  <ClippedPhoto class="page-hero__photo" src={photo} alt={photoAlt} shape={shape} />
</div>

<style>
  .page-hero {
    display: grid;
    grid-template-columns: 1fr 48%;
    align-items: end;
    gap: var(--space-sm);
    margin-block: var(--space-md) var(--space-xl);
  }

  .page-hero__text {
    display: grid;
    justify-items: start;
    gap: var(--space-xs);
    padding-bottom: var(--space-sm);
    border-bottom: 1px solid var(--color-line);
  }

  .page-hero__title {
    font-family: var(--font-family-mincho);
    font-size: var(--font-size-lg);
    letter-spacing: var(--letter-spacing-wide);
    line-height: var(--line-height-tight);
  }

  .page-hero__text :global(.page-hero__motif) {
    width: 40px; /* ページ名に添える小さなモチーフ */
    margin-top: var(--space-xs);
  }

  .page-hero__text :global(.page-hero__motif--kokeshi),
  .page-hero__text :global(.page-hero__motif--koboshi) {
    width: 20px; /* 縦長のモチーフは高さをそろえる */
  }

  /* 768px 以上（tokens.css --breakpoint-md） */
  @media (min-width: 768px) {
    .page-hero {
      grid-template-columns: 1fr minmax(0, 380px);
      gap: var(--space-xl);
      margin-block: var(--space-xl) var(--space-2xl);
    }

    .page-hero__text {
      gap: var(--space-sm);
      padding-bottom: var(--space-md);
    }

    .page-hero__title {
      font-size: var(--font-size-3xl);
    }

    .page-hero__text :global(.page-hero__motif) {
      width: 56px;
    }

    .page-hero__text :global(.page-hero__motif--kokeshi),
    .page-hero__text :global(.page-hero__motif--koboshi) {
      width: 28px;
    }
  }
</style>
