---
// フッター（007 の仮のデザイン）。棚に並んだ民芸のモチーフ → 藍ののれんの色の面に、ロゴ・SNS・フッターナビ・店舗情報・著作権表示。
// 店舗情報（店名・住所・電話）は構造化データと表示を一致させるために出している（開発原則VIII）。
// 元のデザイン（写真の帯とアーチ）は、タグ design-original にある（docs/design-original.md）
import SocialLinks from './SocialLinks.astro';
import Mingei from './Mingei.astro';
import { footerNav, siteName, store, storeAddressText } from '../data/site';
---

<footer class="footer">
  <div class="footer__shelf content-inner" aria-hidden="true">
    <Mingei kind="koma" class="footer__figure footer__figure--koma" />
    <Mingei kind="kokeshi" class="footer__figure footer__figure--kokeshi" />
    <Mingei kind="akabeko" class="footer__figure footer__figure--akabeko" />
    <Mingei kind="koboshi" class="footer__figure footer__figure--koboshi" />
  </div>
  <div class="footer__body">
    <div class="content-inner footer__inner">
      <div class="footer__brand">
        <p class="footer__name">{siteName}</p>
        <p class="footer__sub">民芸くらふと 和久屋 ─ 福島・郡山</p>
        <div class="footer__social">
          <SocialLinks variant="light" size={22} />
        </div>
      </div>
      <ul class="footer__nav">
        {
          footerNav.map((item) => (
            <li>
              <a href={item.href} {...(item.external ? { target: '_blank', rel: 'noopener' } : {})}>
                {item.label}
                {item.external && <span class="visually-hidden">（外部サイト・新しいタブで開きます）</span>}
              </a>
            </li>
          ))
        }
      </ul>
      <address class="footer__store">
        <p class="footer__store-name">{store.name}（{store.legalName}）</p>
        <p>{storeAddressText}</p>
        <p>TEL <a href={`tel:${store.telephone}`}>{store.telephone}</a></p>
      </address>
    </div>
    <p class="footer__copy content-inner"><small>©2023 wakuya.</small></p>
  </div>
</footer>

<style>
  .footer {
    color: var(--color-on-footer);
  }

  /* 棚に並んだ民芸。藍の面の上端を棚板に見立てて、モチーフの足を乗せる */
  .footer__shelf {
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;
    gap: var(--space-sm);
    padding-right: var(--space-sm);
  }

  .footer__shelf :global(.footer__figure--koma) {
    width: 44px; /* モチーフの大きさを、こけしの高さに合わせてそろえた値 */
  }

  .footer__shelf :global(.footer__figure--kokeshi) {
    width: 22px;
  }

  .footer__shelf :global(.footer__figure--akabeko) {
    width: 52px;
  }

  .footer__shelf :global(.footer__figure--koboshi) {
    width: 24px;
  }

  .footer__body {
    padding-block: var(--space-lg);
    background: var(--color-footer-bg);
  }

  .footer__inner {
    display: grid;
    gap: var(--space-md);
    margin-bottom: var(--space-lg);
  }

  .footer__name {
    font-family: var(--font-family-mincho);
    font-size: var(--font-size-2xl);
    letter-spacing: var(--letter-spacing-wide);
    line-height: var(--line-height-tight);
  }

  .footer__sub {
    margin-bottom: var(--space-xs);
    font-family: var(--font-family-mincho);
    font-size: var(--font-size-xs);
    letter-spacing: var(--letter-spacing-wide);
  }

  .footer__social {
    margin-left: calc(-1 * var(--space-xs)); /* アイコンの押せる範囲の余白ぶん、左端をそろえる */
  }

  .footer__nav {
    display: grid;
    align-content: start;
    font-size: var(--font-size-xs);
  }

  .footer__nav a,
  .footer__store a {
    display: inline-flex;
    align-items: center;
    min-height: var(--size-tap-min);
    color: var(--color-on-footer);
  }

  .footer__nav a:hover,
  .footer__store a:hover {
    color: var(--color-on-footer);
    text-decoration-thickness: 2px;
  }

  .footer__store {
    font-size: var(--font-size-xs);
    font-style: normal;
  }

  .footer__store-name {
    font-family: var(--font-family-mincho);
    font-size: var(--font-size-base);
  }

  .footer__copy {
    padding-top: var(--space-sm);
    border-top: 1px solid rgb(247 243 234 / 25%); /* 藍の上の細い罫線（--color-on-footer を薄くしたもの） */
    font-family: var(--font-family-latin);
    letter-spacing: var(--letter-spacing-wide);
  }

  /* 768px 以上（tokens.css --breakpoint-md） */
  @media (min-width: 768px) {
    .footer__shelf {
      gap: var(--space-md);
      padding-right: var(--space-lg);
    }

    .footer__inner {
      grid-template-columns: 1.2fr 1fr 1fr;
      gap: var(--space-lg);
    }
  }
</style>
