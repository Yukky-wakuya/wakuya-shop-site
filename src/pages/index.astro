---
// トップページ。現行サイトと同じ構成：メインビジュアル → おすすめ商品 → お知らせ → わくやの想い → オンラインショップの帯（FR-001〜FR-007）
import BaseLayout from '../layouts/BaseLayout.astro';
import TopHero from '../components/TopHero.astro';
import RecommendedProducts from '../components/RecommendedProducts.astro';
import SectionTitle from '../components/SectionTitle.astro';
import PostCards from '../components/PostCards.astro';
import MoreLink from '../components/MoreLink.astro';
import ThoughtIntro from '../components/ThoughtIntro.astro';
import { getPublishedPosts } from '../lib/blog';
import { websiteJsonLd } from '../lib/structured-data';

const NEWS_COUNT = 4;
const latest = (await getPublishedPosts()).slice(0, NEWS_COUNT);
---

<BaseLayout
  title="福島県民芸雑貨 有限会社和久屋"
  description="福島で長く愛されてきた郷土民芸品や和雑貨を扱う「わくや」（有限会社和久屋）の公式サイトです。赤べこなどの商品はオンラインショップでお求めいただけます。"
  path="/"
  jsonLd={[websiteJsonLd()]}
>
  <TopHero />
  <RecommendedProducts />
  {
    latest.length > 0 && (
      <section class="news" aria-labelledby="news-title">
        <div class="news__inner content-inner">
          <SectionTitle id="news-title" en="News" motif="koboshi">お知らせ</SectionTitle>
          <PostCards posts={latest} columns={4} />
          <MoreLink href="/blogs/" what="お知らせを" />
        </div>
      </section>
    )
  }
  <ThoughtIntro />
</BaseLayout>

<style>
  /* 一段沈んだ生成りの帯。上下に細い罫線を引き、展示室の区切りのように見せる */
  .news {
    margin-bottom: var(--space-xl);
    padding-block: var(--space-xl) var(--space-lg);
    border-block: 1px solid var(--color-line);
    background: var(--color-bg-subtle);
  }

  /* 768px 以上（tokens.css --breakpoint-md）。@media では var() が使えないため直接書く */
  @media (min-width: 768px) {
    .news {
      margin-bottom: 0;
      padding-block: var(--space-2xl) var(--space-xl);
    }
  }
</style>
